<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajustes y Personalización"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1E000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cuenta de Usuario"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/material_dynamic_primary40"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvUsuarioEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cargando usuario..."
                    android:textSize="15sp"
                    android:padding="12dp"
                    android:background="#0A000000" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1E000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apariencia y Accesibilidad"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/material_dynamic_primary40"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opciones de Tema"
                    android:textSize="15sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerThemeOptions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E000000"
                    android:layout_marginVertical="8dp" />

                <Switch
                    android:id="@+id/switchVozBotones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lectura de Voz"
                    android:textSize="15sp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="12dp" />

                <Switch
                    android:id="@+id/switchAltoContraste"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Modo de Alto Contraste Visual"
                    android:textSize="15sp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1E000000"
                    android:layout_marginVertical="8dp" />

                <Switch
                    android:id="@+id/switchNotificaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recordatorios Diarios"
                    android:textSize="15sp"
                    android:paddingVertical="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1E000000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Permisos del Sistema"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@color/material_dynamic_primary40"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnGestionarPermisos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Abrir Ajustes de Permisos (GPS / Notif.)"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvEstadoUbicacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado GPS: Activo"
                    android:textSize="13sp"
                    android:textColor="#666666" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#33FF0000">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zona de Mantenimiento"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="@android:color/holo_red_dark"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnReiniciarDatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Restablecer Datos Locales"
                    android:backgroundTint="@android:color/holo_red_dark"
                    android:textColor="@android:color/white"
                    android:padding="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>